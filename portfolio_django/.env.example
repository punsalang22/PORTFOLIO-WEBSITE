# Copy this file to .env (same folder as manage.py) and fill in real values.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit the real .env file - it is listed in .gitignore.

# Django secret key. Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret-key

# True for local development, False in production (PythonAnywhere).
DEBUG=True

# Comma-separated hostnames allowed to serve the site.
# Production example: yourusername.pythonanywhere.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins (with scheme) trusted for CSRF on form posts.
# Production example: https://yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
